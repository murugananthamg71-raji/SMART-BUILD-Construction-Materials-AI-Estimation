# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=smart_build_jwt_secret_key_change_in_production_2026_xyz!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Production MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_build
# Local SQLite Fallback:
# DATABASE_URL=sqlite:///./smart_build.db
USE_SQLITE_FALLBACK=true

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "https://smart-build.vercel.app"]

# Payment Sandbox (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# AI Settings
ENABLE_AI_PREDICTIONS=true
